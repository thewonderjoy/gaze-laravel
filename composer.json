{
    "name": "thewonderjoy/gaze-laravel",
    "description": "Gaze for Laravel: one trace per request, job, command and test; watchers for queries (N+1, duplicates, slow), logs, exceptions, mails, jobs, events, dumps, views, cache and the HTTP client.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "debug", "dump", "ray", "gaze", "queries", "n-plus-one", "tracing"],
    "homepage": "https://thewonderjoy.com/products/gaze",
    "authors": [
        { "name": "thewonderjoy" }
    ],
    "support": {
        "issues": "https://github.com/thewonderjoy/gaze-laravel/issues",
        "source": "https://github.com/thewonderjoy/gaze-laravel"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "thewonderjoy/gaze-php": "^1.0"
    },
    "require-dev": {
        "opis/json-schema": "^2.4",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "repositories": [
        { "type": "path", "url": "../php", "options": { "symlink": true, "versions": { "thewonderjoy/gaze-php": "1.0.x-dev" } } }
    ],
    "autoload": {
        "psr-4": {
            "TheWonderJoy\\Gaze\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheWonderJoy\\Gaze\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TheWonderJoy\\Gaze\\Laravel\\GazeServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
